========================================================= */

function scrollMessages() {

    const container =
        document.getElementById(
            "messages"
        );

    setTimeout(() => {

        container.scrollTop =
            container.scrollHeight;

    }, 50);

}


/* =========================================================
   SECURITY / HTML
========================================================= */

function escapeHTML(value) {

    return String(value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");

}

