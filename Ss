/* =========================================================
   OPENROUTER
========================================================= */

async function askAI(userText, imageData = null) {

    if (!apiKey) {

        throw new Error(
            "API key غير موجود"
        );

    }

    const systemPrompt =
        buildSystemPrompt();


    /*
       Build previous conversation.
    */

    const previous =
        messages
            .slice(-30)
            .map(m => ({
                role:
                    m.role === "assistant"
                        ? "assistant"
                        : "user",
                content:
                    m.content
            }));


    let userContent;


    if (imageData) {

        userContent = [

            {
                type: "text",
                text:
                    userText ||
                    "حللي هذه الصورة واشرحي لي شنو بيها."
            },

            {
                type: "image_url",
                image_url: {
                    url: imageData
                }
            }

        ];

    } else {

        userContent =
            userText;

    }


    const body = {

        model: "openrouter/free",

        messages: [

            {
                role: "system",
                content: systemPrompt
            },

            ...previous,

            {
                role: "user",
                content: userContent
            }

        ],

        temperature: 0.85,

        max_tokens: 1000

    };


    const response =
        await fetch(
            "https://openrouter.ai/api/v1/chat/completions",
            {

                method: "POST",

                headers: {

                    "Authorization":
                        `Bearer ${apiKey}`,

                    "Content-Type":
                        "application/json",

                    "HTTP-Referer":
                        window.location.href,

                    "X-Title":
                        "AI Girl"

                },

                body:
                    JSON.stringify(body)

            }
        );


    const data =
        await response.json();


    if (!response.ok) {

        console.error(data);

        throw new Error(
            data?.error?.message ||
            "OpenRouter request failed"
        );

    }


    const content =
        data?.choices?.[0]?.message?.content;


    if (!content) {

        throw new Error(
            "AI رجع رد فارغ"
        );

    }


    return parseAIResponse(content);

}


/* =========================================================
   PARSE AI JSON
========================================================= */

function parseAIResponse(content) {

    let cleaned =
        content
            .trim()
            .replace(/^```json/i, "")
            .replace(/^```/i, "")
            .replace(/```$/i, "")
            .trim();


    try {

        const parsed =
            JSON.parse(cleaned);

        return {

            reply:
                parsed.reply ||
                "ما عرفت شنو أجاوب 😭",

            emotion:
                EMOTIONS.includes(
                    parsed.emotion
                )
                    ? parsed.emotion
                    : "neutral"

        };

    } catch (error) {

        /*
           Fallback if model didn't obey JSON.
        */

        return {

            reply: content,

            emotion: "neutral"

        };

    }

}


/* =========================================================
   SEND MESSAGE
========================================================= */

async function sendMessage() {

    const input =
        document.getElementById(
            "messageInput"
        );

    const text =
        input.value.trim();


    if (!text && !selectedImageData) {
        return;
    }


    if (!apiKey) {

        alert(
            "فعلي API أولاً."
        );

        return;

    }


    const image =
        selectedImageData;


    /*
       Show user message.
    */

    addMessage(
        "user",
        image
            ? `${text || "📷 أرسلت صورة"}`
            : text
    );


    input.value = "";

    selectedImageData = null;

    document
        .getElementById("selectedImage")
        .style.display = "none";

    document
        .getElementById("imageInput")
        .value = "";


    /*
       Typing.
    */

    const typing =
        document.getElementById(
            "typing"
        );

    typing.style.display =
        "block";


    scrollMessages();


    try {

        const result =
            await askAI(
                text,
                image
            );


        addMessage(
            "assistant",
            result.reply,
            result.emotion
        );


    } catch (error) {

        console.error(error);

        addMessage(
            "assistant",
            "صار عندي خطأ بالاتصال بالـAI 😭\n\n" +
            error.message,
            "confused"
        );

    } finally {

        typing.style.display =
            "none";

    }

}


