    const bubble =
        document.createElement("div");

    bubble.className = "bubble";

    bubble.textContent =
        content;

    wrapper.appendChild(bubble);

    container.appendChild(wrapper);

    if (scroll) {
        scrollMessages();
    }

}


function addMessage(
    role,
    content,
    emotion = null
) {

    messages.push({

        role,
        content,
        emotion,
        time: Date.now()

    });

    saveMessages();

    addMessageToUI(
        role,
        content,
        true
    );

    if (
        role === "assistant" &&
        emotion
    ) {

        changeEmotionBackground(
            emotion
        );

    }

}


