<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AI Girl</title>

<style>
* {
    box-sizing: border-box;
}

:root {
    --bg: #0d0d12;
    --panel: #15151d;
    --panel2: #1d1d28;
    --border: rgba(255,255,255,.08);
    --text: #f5f5f7;
    --muted: #9999a8;
    --accent: #ff6fae;
    --accent2: #ff9ac7;
    --user: #ff5fa3;
    --ai: #242431;
}

body {
    margin: 0;
    font-family: Arial, "Tahoma", sans-serif;
    background: var(--bg);
    color: var(--text);
    overflow: hidden;
}

/* =========================
   API SCREEN
========================= */

#apiScreen {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    background:
        radial-gradient(circle at 30% 20%, rgba(255,105,170,.18), transparent 30%),
        radial-gradient(circle at 80% 70%, rgba(150,90,255,.15), transparent 30%),
        #0b0b10;
    padding: 20px;
}

.api-card {
    width: min(500px, 100%);
    background: rgba(24,24,33,.94);
    border: 1px solid var(--border);
    border-radius: 28px;
    padding: 32px;
    box-shadow: 0 30px 100px rgba(0,0,0,.5);
    backdrop-filter: blur(20px);
}

.logo {
    width: 76px;
    height: 76px;
    margin: 0 auto 20px;
    border-radius: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg,#ff5fa3,#9b65ff);
    font-size: 38px;
    box-shadow: 0 15px 40px rgba(255,95,163,.25);
}

.api-card h1 {
    text-align: center;
    margin: 0 0 10px;
}

.api-card p {
    text-align: center;
    color: var(--muted);
    line-height: 1.7;
}

.input {
    width: 100%;
    border: 1px solid var(--border);
    background: #101017;
    color: white;
    padding: 14px 16px;
    border-radius: 14px;
    outline: none;
    font-size: 15px;
}

.input:focus {
    border-color: var(--accent);
}

.btn {
    border: 0;
    border-radius: 14px;
    padding: 13px 18px;
    cursor: pointer;
    font-weight: bold;
    color: white;
    background: linear-gradient(135deg,#ff5fa3,#a05cff);
    transition: .2s;
}

.btn:hover {
    transform: translateY(-1px);
    filter: brightness(1.08);
}

.full {
    width: 100%;
}

.note {
    font-size: 12px;
    color: #777783;
    margin-top: 12px;
}

/* =========================
   APP
========================= */

#app {
    height: 100vh;
    display: none;
}

.app {
    height: 100%;
    display: grid;
    grid-template-columns: 350px 1fr;
}

/* =========================
   SIDEBAR
========================= */

.sidebar {
    height: 100vh;
    background: var(--panel);
    border-left: 1px solid var(--border);
    overflow-y: auto;
    padding: 18px;
}

.sidebar-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
}

.sidebar-title h2 {
    margin: 0;
    font-size: 21px;
}

.section {
    background: var(--panel2);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 15px;
    margin-bottom: 14px;
}

.section h3 {
    margin: 0 0 13px;
    font-size: 15px;
}

.field {
    margin-bottom: 10px;
}

.field label {
    display: block;
    color: #b7b7c4;
    font-size: 12px;
    margin-bottom: 6px;
}

textarea.input {
    min-height: 80px;
    resize: vertical;
}

select.input {
    appearance: auto;
}

.small-btn {
    padding: 9px 12px;
    font-size: 12px;
}

.people-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 10px;
}

.person {
    background: #111119;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 10px;
}

.person-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.person-name {
    font-weight: bold;
}

.person-info {
    color: var(--muted);
    font-size: 12px;
    line-height: 1.5;
    margin-top: 5px;
}

.delete {
    background: transparent;
    border: 0;
    color: #ff6b7c;
    cursor: pointer;
}

/* =========================
   EMOTION IMAGES
========================= */

.emotion-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 9px;
}

.emotion-box {
    background: #111119;
    border: 1px solid var(--border);
    border-radius: 13px;
    padding: 9px;
}

.emotion-box label {
    display: block;
    font-size: 12px;
    margin-bottom: 7px;
    color: #ddd;
}

.emotion-box input {
    width: 100%;
    font-size: 10px;
    color: #aaa;
}

.preview {
    width: 100%;
    aspect-ratio: 16/9;
    border-radius: 9px;
    object-fit: cover;
    display: none;
    margin-top: 7px;
}

/* =========================
   CHAT
========================= */

.chat {
    position: relative;
    height: 100vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: #101017;
}

.chat-background {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0;
    transition:
        opacity .5s ease,
        background-image .5s ease;
    pointer-events: none;
}

.chat-background::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
        linear-gradient(
            to bottom,
            rgba(10,10,15,.62),
            rgba(10,10,15,.25) 35%,
            rgba(10,10,15,.72)
        );
}

.chat-header,
.messages,
.composer {
    position: relative;
    z-index: 2;
}

.chat-header {
    height: 70px;
    flex-shrink: 0;
    padding: 12px 18px;
    display: flex;
    align-items: center;
    gap: 12px;
    border-bottom: 1px solid var(--border);
    background: rgba(13,13,18,.72);
    backdrop-filter: blur(15px);
}

.avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: linear-gradient(135deg,#ff6fae,#985dff);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
}

.header-name {
    font-weight: bold;
}

.status {
    color: #76e39a;
    font-size: 11px;
    margin-top: 3px;
}

.header-actions {
    margin-right: auto;
    display: flex;
    gap: 8px;
}

.messages {
    flex: 1;
    overflow-y: auto;
    padding: 25px;
}

.message {
    display: flex;
    margin-bottom: 15px;
}

.message.user {
    justify-content: flex-start;
}

.message.ai {
    justify-content: flex-end;
}

.bubble {
    max-width: min(760px, 82%);
    padding: 13px 16px;
    border-radius: 18px;
    line-height: 1.7;
    white-space: pre-wrap;
    word-break: break-word;
    box-shadow: 0 8px 25px rgba(0,0,0,.12);
}

.message.user .bubble {
    background: linear-gradient(135deg,#ff5b9f,#c25cff);
    border-bottom-left-radius: 5px;
}

.message.ai .bubble {
    background: rgba(34,34,45,.88);
    border: 1px solid rgba(255,255,255,.07);
    border-bottom-right-radius: 5px;
    backdrop-filter: blur(10px);
}

.message-time {
    color: #777783;
    font-size: 9px;
    margin-top: 5px;
}

.typing {
    display: none;
    padding: 10px 16px;
    color: #aaa;
    font-size: 13px;
}

.composer {
    padding: 12px;
    background: rgba(13,13,18,.82);
    backdrop-filter: blur(18px);
    border-top: 1px solid var(--border);
}

.composer-row {
    display: flex;
    gap: 8px;
}

.composer textarea {
    flex: 1;
    min-height: 48px;
    max-height: 130px;
    resize: none;
}

.icon-btn {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: #1c1c26;
    color: white;
    cursor: pointer;
    font-size: 19px;
}

.send {
    background: linear-gradient(135deg,#ff5fa3,#9e5cff);
    border: 0;
}

.selected-image {
    display: none;
    padding: 8px;
    margin-bottom: 8px;
    border-radius: 12px;
    background: #1c1c26;
    font-size: 12px;
    color: #bbb;
}

/* =========================
   MOBILE
========================= */

.mobile-menu {
    display: none;
}

@media(max-width: 900px) {

    body {
        overflow: auto;
    }

    .app {
        grid-template-columns: 1fr;
    }

    .sidebar {
        position: fixed;
        right: -100%;
        top: 0;
        width: min(360px, 92%);
        z-index: 500;
        transition: .3s;
        box-shadow: -20px 0 70px rgba(0,0,0,.5);
    }

    .sidebar.open {
        right: 0;
    }

    .mobile-menu {
        display: block;
        position: fixed;
        right: 15px;
        top: 15px;
        z-index: 400;
        width: 45px;
        height: 45px;
        border-radius: 13px;
        border: 1px solid var(--border);
        background: rgba(20,20,28,.9);
        color: white;
        cursor: pointer;
    }

    .messages {
        padding: 18px 12px 100px;
    }

    .bubble {
        max-width: 88%;
    }

    .emotion-grid {
        grid-template-columns: 1fr;
    }
}
</style>
</head>

<body>

<!-- =========================
     API SCREEN
========================= -->

<div id="apiScreen">

    <div class="api-card">

        <div class="logo">💗</div>

        <h1>AI Girl</h1>

        <p>
            خلي مفتاح OpenRouter هنا حتى تفعّلين الذكاء الاصطناعي.
            المفتاح ينخزن محليًا على هذا الجهاز.
        </p>

        <input
            id="apiKeyInput"
            class="input"
            type="password"
            placeholder="sk-or-v1-..."
        >

        <br><br>

        <button class="btn full" onclick="activateAI()">
            تفعيل AI Girl
        </button>

        <div class="note">
            ملاحظة: لا تشاركين مفتاحك مع أي شخص.
        </div>

    </div>

</div>


<!-- =========================
     APP
========================= -->

<div id="app">

    <div class="app">

        <!-- MOBILE MENU -->

        <button class="mobile-menu" onclick="toggleSidebar()">
            ☰
        </button>


        <!-- SIDEBAR -->

        <aside class="sidebar" id="sidebar">

            <div class="sidebar-title">
                <h2>⚙️ إعدادات AI Girl</h2>
                <button
                    class="btn small-btn"
                    onclick="changeApiKey()">
                    API
                </button>
            </div>


            <!-- PERSONALITY -->

            <div class="section">

                <h3>👩 الشخصية</h3>

                <div class="field">
                    <label>الاسم</label>
                    <input
                        id="girlName"
                        class="input"
                        value="Luna">
                </div>

                <div class="field">
                    <label>العمر</label>
                    <input
                        id="girlAge"
                        class="input"
                        value="19">
                </div>

                <div class="field">
                    <label>الشخصية</label>
                    <textarea
                        id="girlPersonality"
                        class="input"
                        placeholder="مثلاً: لطيفة، مرحة، صريحة، أحياناً عنيدة..."></textarea>
                </div>

                <div class="field">
                    <label>تحب</label>
                    <textarea
                        id="girlLikes"
                        class="input"
                        placeholder="مثلاً: الأنمي، القطط، الألعاب..."></textarea>
                </div>

                <div class="field">
                    <label>ما تحب</label>
                    <textarea
                        id="girlDislikes"
                        class="input"
                        placeholder="مثلاً: الكذب، الإزعاج..."></textarea>
                </div>

                <div class="field">
                    <label>اللهجة</label>

                    <select id="girlDialect" class="input">
                        <option value="iraqi">عراقي</option>
                        <option value="arabic">عربي</option>
                        <option value="english">English</option>
                    </select>
                </div>

                <button
                    class="btn full"
                    onclick="savePersonality()">
                    حفظ الشخصية
                </button>

            </div>


            <!-- SPEAKING STYLE -->

            <div class="section">

                <h3>🗣️ أسلوب الكلام</h3>

                <div class="field">

                    <label>اختاري الأسلوب</label>

                    <select
                        id="speakingStyle"
                        class="input"
                        onchange="toggleCustomStyle()">

                        <option value="iraqi_casual">
                            عراقي عفوي
                        </option>

                        <option value="iraqi_soft">
                            عراقي هادئ ولطيف
                        </option>

                        <option value="iraqi_funny">
                            عراقي مضحك
                        </option>

                        <option value="iraqi_youth">
                            عراقي شبابي
                        </option>

                        <option value="calm">
                            هادئ
                        </option>

                        <option value="short">
                            مختصر
                        </option>

                        <option value="talkative">
                            حچي كثير
                        </option>

                        <option value="formal">
                            رسمي
                        </option>

                        <option value="custom">
                            مخصص
                        </option>

                    </select>

                </div>

                <div
                    class="field"
                    id="customStyleBox"
                    style="display:none">

                    <label>
                        اكتبي أسلوب الكلام اللي تريدينه
                    </label>

                    <textarea
                        id="customSpeakingStyle"
                        class="input"
                        placeholder="مثلاً: احچي عراقي، طبيعي، مختصر، لا تستخدمين كلمات رسمية، استخدمي إيموجي أحياناً..."></textarea>

                </div>

                <button
                    class="btn full"
                    onclick="saveSpeakingStyle()">

                    حفظ أسلوب الكلام

                </button>

            </div>


            <!-- PEOPLE -->

            <div class="section">

                <h3>👥 الأشخاص بحياتك</h3>

                <div class="field">
                    <label>الاسم</label>
                    <input
                        id="personName"
                        class="input"
                        placeholder="مثلاً: أمي">
                </div>

                <div class="field">
                    <label>العلاقة</label>
                    <input
                        id="personRelation"
                        class="input"
                        placeholder="أم / أخ / صديقة / مدرس...">
                </div>

                <div class="field">
                    <label>معلومات عنه</label>
                    <textarea
                        id="personInfo"
                        class="input"
                        placeholder="اكتبي الأشياء التي تريدين AI يتذكرها عنه"></textarea>
                </div>

                <button
                    class="btn full"
                    onclick="addPerson()">
                    + إضافة شخص
                </button>

                <div
                    id="peopleList"
                    class="people-list">
                </div>

            </div>


            <!-- EMOTION IMAGES -->

            <div class="section">

                <h3>🎭 صور المشاعر</h3>

                <p style="
                    color:#9999a8;
                    font-size:11px;
                    line-height:1.6;
                    margin-top:0;
                ">
                    اختاري صورة لكل شعور.
                    الصورة راح تظهر كخلفية للمحادثة
                    عندما تشعر AI بهذا الشعور.
                </p>

                <div class="emotion-grid">

                    <div class="emotion-box">
                        <label>😐 محايد</label>
                        <input type="file" accept="image/*"
                               data-emotion="neutral"
                               onchange="previewEmotion(this)">
                        <img class="preview">
                    </div>

                    <div class="emotion-box">
                        <label>😊 فرح</label>
                        <input type="file" accept="image/*"
                               data-emotion="happy"
                               onchange="previewEmotion(this)">
                        <img class="preview">
                    </div>

                    <div class="emotion-box">
                        <label>😂 ضحك</label>
                        <input type="file" accept="image/*"
                               data-emotion="laugh"
                               onchange="previewEmotion(this)">
                        <img class="preview">
                    </div>

                    <div class="emotion-box">
                        <label>😢 حزن</label>
                        <input type="file" accept="image/*"
                               data-emotion="sad"
                               onchange="previewEmotion(this)">
                        <img class="preview">
                    </div>

                    <div class="emotion-box">
                        <label>😡 غضب</label>
                        <input type="file" accept="image/*"
                               data-emotion="angry"
                               onchange="previewEmotion(this)">
                        <img class="preview">
                    </div>

                    <div class="emotion-box">
                        <label>😳 خجل</label>
                        <input type="file" accept="image/*"
                               data-emotion="shy"
                               onchange="previewEmotion(this)">
                        <img class="preview">
                    </div>

                    <div class="emotion-box">
                        <label>😲 مفاجأة</label>
                        <input type="file" accept="image/*"
                               data-emotion="surprised"
                               onchange="previewEmotion(this)">
                        <img class="preview">
                    </div>

                    <div class="emotion-box">
                        <label>😕 حيرة</label>
                        <input type="file" accept="image/*"
                               data-emotion="confused"
                               onchange="previewEmotion(this)">
                        <img class="preview">
                    </div>

                    <div class="emotion-box">
                        <label>🤔 تفكير</label>
                        <input type="file" accept="image/*"
                               data-emotion="thinking"
                               onchange="previewEmotion(this)">
                        <img class="preview">
                    </div>

                    <div class="emotion-box">
                        <label>❤️ حب</label>
                        <input type="file" accept="image/*"
                               data-emotion="love"
                               onchange="previewEmotion(this)">
                        <img class="preview">
                    </div>

                    <div class="emotion-box">
                        <label>😴 نعاس</label>
                        <input type="file" accept="image/*"
                               data-emotion="sleepy"
                               onchange="previewEmotion(this)">
                        <img class="preview">
                    </div>

                    <div class="emotion-box">
                        <label>🤩 حماس</label>
                        <input type="file" accept="image/*"
                               data-emotion="excited"
                               onchange="previewEmotion(this)">
                        <img class="preview">
                    </div>

                </div>

                <br>

                <button
                    class="btn full"
                    onclick="saveEmotionImages()">

                    💾 حفظ صور المشاعر

                </button>

            </div>


            <!-- RESET -->

            <div class="section">

                <button
                    class="btn full"
                    onclick="clearMemory()"
                    style="background:#39202a">

                    🗑️ مسح ذاكرة المحادثة

                </button>

            </div>

        </aside>


        <!-- CHAT -->

        <main class="chat">

            <div
                id="chatBackground"
                class="chat-background">
            </div>


            <!-- HEADER -->

            <header class="chat-header">

                <div class="avatar">
                    💗
                </div>

                <div>

                    <div
                        id="headerName"
                        class="header-name">
                        Luna
                    </div>

                    <div class="status">
                        ● AI Online
                    </div>

                </div>

                <div class="header-actions">

                    <button
                        class="icon-btn"
                        onclick="toggleSidebar()">
                        ⚙️
                    </button>

                </div>

            </header>


            <!-- MESSAGES -->

            <div
                id="messages"
                class="messages">
            </div>


            <div
                id="typing"
                class="typing">

                AI Girl تكتب...

            </div>


            <!-- COMPOSER -->

            <div class="composer">

                <div
                    id="selectedImage"
                    class="selected-image">
                </div>

                <div class="composer-row">

                    <input
                        type="file"
                        id="imageInput"
                        accept="image/*"
                        style="display:none"
                        onchange="handleImage(event)">

                    <button
                        class="icon-btn"
                        onclick="document.getElementById('imageInput').click()">

                        📷

                    </button>

                    <textarea
                        id="messageInput"
                        class="input"
                        placeholder="اكتبي شيء لـ AI Girl..."
                        onkeydown="handleEnter(event)">
                    </textarea>

                    <button
                        class="icon-btn send"
                        onclick="sendMessage()">

                        ➤

                    </button>

                </div>

            </div>

        </main>

    </div>

</div>


<script>

/* =========================================================
   GLOBAL DATA
========================================================= */

const EMOTIONS = [
    "neutral",
    "happy",
    "laugh",
    "sad",
    "angry",
    "shy",
    "surprised",
    "confused",
    "thinking",
    "love",
    "sleepy",
    "excited"
];

let apiKey = localStorage.getItem("aiGirl_apiKey") || "";

let people =
    JSON.parse(
        localStorage.getItem("aiGirl_people") || "[]"
    );

let messages =
    JSON.parse(
        localStorage.getItem("aiGirl_messages") || "[]"
    );

let emotionImages =
    JSON.parse(
        localStorage.getItem("aiGirl_emotionImages") || "{}"
    );

let selectedImageData = null;


/* =========================================================
   STARTUP
========================================================= */

document.addEventListener("DOMContentLoaded", () => {

    if (apiKey) {
        showApp();
    }

    loadPersonality();
    loadSpeakingStyle();
    renderPeople();
    loadEmotionPreviews();
    renderMessages();

});


/* =========================================================
   API
========================================================= */

function activateAI() {

    const key =
        document
            .getElementById("apiKeyInput")
            .value
            .trim();

    if (!key) {
        alert("حطي مفتاح OpenRouter أولاً.");
        return;
    }

    apiKey = key;

    localStorage.setItem(
        "aiGirl_apiKey",
        apiKey
    );

    showApp();
}


function changeApiKey() {

    const ok =
        confirm(
            "تريدين تغيير مفتاح API؟"
        );

    if (!ok) return;

    localStorage.removeItem(
        "aiGirl_apiKey"
    );

    location.reload();
}


function showApp() {

    document
        .getElementById("apiScreen")
        .style.display = "none";

    document
        .getElementById("app")
        .style.display = "block";

}


/* =========================================================
   SIDEBAR
========================================================= */

function toggleSidebar() {

    document
        .getElementById("sidebar")
        .classList.toggle("open");

}


/* =========================================================
   PERSONALITY
========================================================= */

function savePersonality() {

    const data = {

        name:
            document
